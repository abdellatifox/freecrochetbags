{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "freecrochetbags",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2025-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": { "enabled": true },
  "workers_dev": true,

  "routes": [
    { "pattern": "freecrochetbags.com", "custom_domain": true },
    { "pattern": "www.freecrochetbags.com", "custom_domain": true }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "freecrochetbags-db",
      "database_id": "552a8f77-afd1-459c-9d9c-af8fb26ab022",
      "migrations_dir": "migrations"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "fd97bb4310e941aeaf96cd120e5a0efc"
    }
  ]

  // npx wrangler secret put ADMIN_TOKEN   (never commit it)
}
