---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../lib/site';
import { socialImage } from '../lib/images';

interface Props {
  title?: string;
  /** Use `title` as the full <title> as-is (e.g. a hand-written seoTitle), without the site-name suffix. */
  exactTitle?: boolean;
  /** Title for social cards / Pinterest (defaults to `title`). */
  ogTitle?: string;
  description?: string;
  /** public/ path of the page's main image; its JPG social variant becomes og:image. */
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
  ogType?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  section?: string;
  tags?: string[];
}

const {
  title,
  exactTitle = false,
  ogTitle,
  description = SITE.description,
  image,
  imageAlt,
  noindex = false,
  jsonLd,
  ogType = 'website',
  publishedTime,
  modifiedTime,
  section,
  tags = [],
} = Astro.props;
const fullTitle = title ? (exactTitle ? title : `${title} – ${SITE.name}`) : `${SITE.name} – ${SITE.tagline}`;
const socialTitle = ogTitle ?? title ?? fullTitle;
const site = Astro.site ?? Astro.url;
// Canonical = absolute URL on the real domain, no trailing slash (except the home page).
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/').replace(/(.)\/$/, '$1');
const canonical = new URL(path, site).href;
const og = socialImage(image);
const ogImage = new URL(og.src, site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#ffffff" />
    <script is:inline>
      // Apply the saved theme before first paint (white is the default).
      try {
        if (localStorage.getItem('theme') === 'dark') {
          document.documentElement.dataset.theme = 'dark';
          document.querySelector('meta[name="theme-color"]').content = '#1f1e19';
        }
      } catch {}
    </script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content={String(og.width)} />
    <meta property="og:image:height" content={String(og.height)} />
    {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    {modifiedTime && <meta property="og:updated_time" content={modifiedTime.toISOString()} />}
    {ogType === 'article' && <meta property="article:author" content={SITE.author} />}
    {section && <meta property="article:section" content={section} />}
    {tags.map((t) => <meta property="article:tag" content={t} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {SITE.pinterestVerify && <meta name="p:domain_verify" content={SITE.pinterestVerify} />}
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Nunito:ital,wght@0,400;0,700;0,800;1,400&family=Nunito+Sans:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
