---
import type { Pattern } from '../lib/patterns';
import { coverOrPlaceholder, responsive } from '../lib/images';

interface Props {
  pattern: Pick<Pattern, 'url' | 'title' | 'cover' | 'categoryName' | 'difficulty'>;
  eager?: boolean;
}
const { pattern, eager = false } = Astro.props;
const img = responsive(coverOrPlaceholder(pattern.cover));
---

<article class="card">
  <a href={pattern.url} class="card__link">
    <div class="card__media">
      <img
        src={img.src}
        srcset={img.srcset}
        sizes="(min-width: 1180px) 360px, (min-width: 720px) 30vw, (min-width: 520px) 45vw, 100vw"
        alt={pattern.title}
        width={img.width ?? 600}
        height={img.height ?? 750}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
      />
    </div>
    <p class="card__meta">
      <span class="card__cat">{pattern.categoryName}</span>
      <span aria-hidden="true">·</span>
      <span>{pattern.difficulty}</span>
    </p>
    <h3 class="card__title">{pattern.title}</h3>
  </a>
</article>

<style is:global>
  /* Global so search results built in the browser (PatternListing) get the same look. */
  .card__link { display: block; text-decoration: none; color: inherit; }
  .card__media {
    aspect-ratio: 4 / 5; border-radius: var(--radius); overflow: hidden; background: var(--surface);
  }
  .card__media img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
  .card__link:hover .card__media img { transform: scale(1.03); }
  .card__meta {
    display: flex; gap: 8px; align-items: center; margin: 14px 0 4px;
    font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted);
  }
  .card__cat { color: var(--accent-strong); font-weight: 700; }
  .card__title { font-size: 1.05rem; font-weight: 700; margin: 0; line-height: 1.4; }
  .card__link:hover .card__title { color: var(--accent-strong); }
</style>
