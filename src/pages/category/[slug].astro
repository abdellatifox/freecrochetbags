---
import PatternListing from '../../components/PatternListing.astro';
import { CATEGORIES } from '../../lib/site';
import { getPatternsIn, type Pattern } from '../../lib/patterns';

export const prerender = true;

export async function getStaticPaths() {
  return Promise.all(
    CATEGORIES.map(async (c) => ({ params: { slug: c.slug }, props: { patterns: await getPatternsIn(c.slug) } })),
  );
}

const { patterns } = Astro.props as { patterns: Pattern[] };
---

<PatternListing patterns={patterns} page={1} category={Astro.params.slug} />
